{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "crons": [
    {
      "path": "/api/cron-calendar-reminders",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron-weekly-report-notify",
      "schedule": "0 17 * * 0"
    },
    {
      "path": "/api/cron-tuition-notify",
      "schedule": "0 6 * * *"
    }
  ]
}
